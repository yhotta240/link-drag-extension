{
  "manifest_version": 3,
  "name": "Link Drag",
  "short_name": "Link Drag",
  "version": "0.3.0",
  "description": "リンクをドラッグするだけで，新しいタブで開く操作やURLのコピーが手軽にできます",
  "homepage_url": "https://github.com/yhotta240/link-drag-extension",
  "icons": {
    "128": "icons/icon.png"
  },
  "permissions": [
    "storage",
    "clipboardWrite",
    "downloads"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "all_frames": true,
      "js": [
        "content.js"
      ]
    }
  ]
}
