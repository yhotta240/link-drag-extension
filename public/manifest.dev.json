{
  "manifest_version": 3,
  "name": "Link Drag",
  "short_name": "Link Drag",
  "version": "0.0.1",
  "description": "リンクをドラッグする方向で，タブやウィンドウの開き方やURLコピーを切り替えるChrome拡張機能",
  "homepage_url": "https://github.com/yhotta240/link-drag-extension",
  "icons": {
    "128": "icons/icon.png"
  },
  "permissions": ["storage", "tabs"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["content.js"]
    }
  ]
}
