{
  "name": "link-drag-extension",
  "version": "0.3.0",
  "description": "リンクをドラッグするだけで，新しいタブで開く操作やURLのコピーが手軽にできます",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "biome check src",
    "check:fix": "biome check --write --unsafe src",
    "typecheck": "tsc --noEmit",
    "build": "npm run check && npm run typecheck && vite build",
    "build:dev": "vite build --mode development",
    "watch": "vite build --mode development --watch",
    "version:patch": "exr version patch --manifest ./public/manifest.prod.json",
    "version:minor": "exr version minor --manifest ./public/manifest.prod.json",
    "version:major": "exr version major --manifest ./public/manifest.prod.json",
    "pack": "npm run build && exr pack dist/",
    "release": "npm run build && exr release dist/ --force"
  },
  "keywords": [
    "chrome-extension",
    "link-drag",
    "drag-and-drop"
  ],
  "homepage": "https://github.com/yhotta240/link-drag-extension#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yhotta240/link-drag-extension.git"
  },
  "bugs": {
    "url": "https://github.com/yhotta240/link-drag-extension/issues"
  },
  "author": "yhotta240",
  "license": "MIT",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.9",
    "@types/chrome": "^0.1.6",
    "@types/node": "^24.3.1",
    "@types/sanitize-html": "^2.16.0",
    "@types/ws": "^8.18.1",
    "@yhotamos/extension-release-cli": "^0.5.0",
    "gray-matter": "^4.0.3",
    "marked": "^17.0.3",
    "sanitize-html": "^2.17.1",
    "typescript": "^7.0.2",
    "vite": "^8.0.16",
    "vite-plugin-css-injected-by-js": "^5.0.1",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "5.1.0",
    "ws": "^8.18.3"
  },
  "dependencies": {
    "bootstrap": "^5.3.8"
  }
}
